{
  "name": "netspecture",
  "private": true,
  "version": "2.1.0",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env NODE_ENV=development electron .\"",
    "fetch-icons": "node scripts/fetch-icons.js",
    "build": "node scripts/fetch-icons.js && vite build && electron-builder --win --x64",
    "build:vite": "vite build",
    "build:electron": "electron-builder --win --x64",
    "preview": "vite preview"
  },
  "dependencies": {
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.5",
    "electron-updater": "^6.8.9",
    "framer-motion": "^12.42.0",
    "lucide-react": "^1.49.0",
    "node-netstat": "^1.9.0",
    "ping": "^1.0.0",
    "postcss": "^8.5.28",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "systeminformation": "^5.33.14",
    "tailwindcss": "^3.4.17",
    "wait-on": "^9.5.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "^10.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "vite": "^8.3.0"
  },
  "build": {
    "appId": "com.netspecture.interfaces",
    "productName": "NetSpecture",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Flypov",
        "repo": "netspecture"
      }
    ]
  }
}
